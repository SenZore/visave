{
  "name": "senzdev-visave",
  "version": "0.3.2",
  "private": true,
  "description": "Firefox video saver with a bundled Windows download companion",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "start": "web-ext run --source-dir extension --firefox \"C:/Program Files/Mozilla Firefox/firefox.exe\"",
    "preview": "node tools/preview.cjs"
  },
  "devDependencies": {
    "selenium-webdriver": "^4.50.0",
    "web-ext": "^10.7.0"
  }
}
